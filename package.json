{
  "name": "@bithyte/ribbon",
  "version": "0.1.0",
  "description": "Configurable status line for Claude Code",
  "type": "module",
  "bin": {
    "ribbon": "dist/cli/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24",
    "prettier": "^3",
    "typescript": "^7"
  },
  "license": "MIT"
}
